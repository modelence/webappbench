# Copy to `.env` and fill in as needed.
# Secrets are never committed; `.env` is gitignored.

# ---- Browser / Playwright ----
# Set to 1 to run browsers headlessly (default in CI).
# Unset or set to 0 to watch the browser during local scoring.
BENCHMARK_HEADLESS=1

# ---- LLM Judge (V1 visual scorer) ----
# OpenRouter API key — get one at https://openrouter.ai
# Without this, V1 scorer returns N/A (all other scorers still work).
OPENROUTER_API_KEY=

# Vision model to use (any OpenRouter vision model).
# Defaults to google/gemini-2.5-pro if not set.
# OPENROUTER_MODEL=google/gemini-2.5-pro
