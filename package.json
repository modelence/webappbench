{
  "name": "webappbench",
  "version": "0.3.0",
  "description": "Reproducible open-source benchmark for AI sitebuilder products",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modelence/webappbench.git"
  },
  "homepage": "https://github.com/modelence/webappbench",
  "bugs": {
    "url": "https://github.com/modelence/webappbench/issues"
  },
  "keywords": [
    "benchmark",
    "ai",
    "sitebuilder",
    "lighthouse",
    "eslint",
    "accessibility",
    "webapp"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "webappbench": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist",
    "prompts",
    "submissions.example.yaml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "bench": "tsx src/cli.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@playwright/test": "^1.49.1",
    "adm-zip": "^0.5.17",
    "chrome-launcher": "^1.2.1",
    "commander": "^12.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-sonarjs": "^4.0.3",
    "lighthouse": "^13.1.0",
    "openai": "^4.104.0",
    "typescript-eslint": "^8.59.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20.17.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
